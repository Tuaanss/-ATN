# ===== Server =====
PORT=3000
# Origin của FE khi chạy dev (Vite) – dùng cho CORS
WEB_ORIGIN=http://localhost:5173

# ===== CSDL MySQL 16 =====
# `npm run db:start` (MySQL nhúng) hoặc docker/compose.dev.yml đều mở cổng 5433
DATABASE_URL=mysql://frameup:frameup@localhost:3306/frameup

# ===== Xác thực =====
# Đổi thành chuỗi ngẫu nhiên dài khi chạy thật
JWT_SECRET=doi-chuoi-bi-mat-nay
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# ===== Lưu trữ tệp =====
# Thư mục chứa tệp tạm / bản cục bộ
DATA_DIR=./data
# Dung lượng tối đa mỗi tệp (MB)
UPLOAD_MAX_FILE_MB=500

# ===== Google Drive =====
# local  : mô phỏng Drive bằng thư mục ./data/drive (chạy thử không cần Google)
# google : ghi thật lên Google Drive – GV liên kết tài khoản Google (OAuth) hoặc dùng Service Account (Shared Drive)
DRIVE_MODE=local
# Khóa JSON của Service Account, mã hóa base64 (chỉ cần khi DRIVE_MODE=google)
GOOGLE_SA_KEY_BASE64=
# OAuth – mỗi giảng viên tự liên kết tài khoản Google ở trang "Kết nối Google Drive"
# (Google Cloud Console → Credentials → OAuth client ID, loại Web application;
#  Authorized redirect URI: http://localhost:5173/api/v1/lecturer/drive/oauth/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=   (mặc định <WEB_ORIGIN>/api/v1/lecturer/drive/oauth/callback)
