// EduPortfolio – Prisma schema (PostgreSQL 16)
// Phạm vi v3.0 (docs/DatabaseDesign.md): hệ thống lưu trữ kết quả học tập –
// GV giao bài, tải danh sách nhóm và điểm bằng Excel; SV xem nhóm, nhập đề tài, nộp bài.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== Enum =====================

enum UserRole {
  ADMIN
  LECTURER
  STUDENT
  PARENT
  ENTERPRISE

  @@map("user_role")
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  REJECTED
  DISABLED

  @@map("user_status")
}

enum TermType {
  TERM_1
  TERM_2
  SUMMER

  @@map("term_type")
}

enum CourseType {
  DESIGN
  PROGRAMMING
  OTHER

  @@map("course_type")
}

enum DriveAuthMode {
  SERVICE_ACCOUNT
  OAUTH

  @@map("drive_auth_mode")
}

enum DriveLinkStatus {
  OK
  NO_PERMISSION
  NOT_FOUND
  NOT_SHARED_DRIVE
  QUOTA_EXCEEDED
  /// Google thu hồi refresh token (hết hạn 7 ngày ở chế độ Testing, GV gỡ quyền, đổi mật khẩu…)
  EXPIRED

  @@map("drive_link_status")
}

enum WorkMode {
  INDIVIDUAL
  GROUP // nhóm do GV tải lên bằng file Excel

  @@map("work_mode")
}

enum ProductType {
  IMAGE
  FIGMA
  VIDEO
  SOURCE
  GIT_LINK
  REPORT // báo cáo PDF / DOC / DOCX

  @@map("product_type")
}

enum AssignmentStatus {
  DRAFT
  OPEN
  CLOSED

  @@map("assignment_status")
}

enum MemberRole {
  LEADER
  MEMBER

  @@map("member_role")
}

enum TopicAction {
  CREATE
  UPDATE

  @@map("topic_action")
}

enum ReportStatus {
  OPEN
  RESOLVED

  @@map("report_status")
}

enum ImportType {
  ASSIGNMENT_GROUPS
  ASSIGNMENT_GRADES
  SECTION_GRADES

  @@map("import_type")
}

enum ImportStatus {
  PREVIEW
  COMPLETED
  CANCELLED

  @@map("import_status")
}

enum GradeStatus {
  DRAFT
  PUBLISHED

  @@map("grade_status")
}

enum SubmissionKind {
  GROUP_SHARED
  PERSONAL

  @@map("submission_kind")
}

enum SubmissionStatus {
  SUBMITTED
  LATE

  @@map("submission_status")
}

enum SyncSummary {
  PENDING
  SYNCED
  ERROR

  @@map("sync_summary")
}

enum FileType {
  IMAGE
  VIDEO
  SOURCE
  DOCUMENT // tệp báo cáo

  @@map("file_type")
}

enum FileSyncStatus {
  PENDING
  UPLOADING
  SYNCED
  FAILED
  MISSING

  @@map("file_sync_status")
}

enum SubmissionAction {
  SUBMIT
  RESUBMIT
  DELETE_FILES
  SYNC_FAILED

  @@map("submission_action")
}

// ===================== Auth & hồ sơ =====================

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String     @unique @db.VarChar(100)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  role               UserRole
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz
  email              String?    @db.VarChar(255)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  /// Cài đặt nhận thông báo: { [loại]: { app: boolean, email: boolean } } + digest
  notificationPrefs  Json       @default("{}") @map("notification_prefs")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  lecturer       Lecturer?
  student        Student?
  parent         Parent?
  notifications  Notification[]
  topicHistories TopicHistory[]
  auditLogs      AuditLog[]
  importJobs     ImportJob[]

  resetTokens PasswordResetToken[]

  enterprise Enterprise?

  @@map("users")
}

model Lecturer {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  code      String   @unique @db.VarChar(20)
  fullName  String   @map("full_name") @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user            User                     @relation(fields: [userId], references: [id])
  sections        CourseSection[]
  driveLink       LecturerDriveLink?
  assignments     Assignment[]
  notes           LecturerNote[]
  semesterFolders LecturerSemesterFolder[]

  gradeRequests GradeChangeRequest[]

  facultyId String?  @map("faculty_id") @db.Uuid
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  @@map("lecturers")
}

model Student {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  studentCode        String    @unique @map("student_code") @db.VarChar(20)
  fullName           String    @map("full_name") @db.VarChar(100)
  dateOfBirth        DateTime  @map("date_of_birth") @db.Date
  cohort             String?   @db.VarChar(10)
  major              String?   @db.VarChar(200)
  phone              String?   @unique @db.VarChar(10)
  email              String?   @unique @db.VarChar(255)
  fatherPhone        String?   @map("father_phone") @db.VarChar(10)
  motherPhone        String?   @map("mother_phone") @db.VarChar(10)
  guardianPhone      String?   @map("guardian_phone") @db.VarChar(10)
  noParentReason     String?   @map("no_parent_reason") @db.VarChar(255)
  discoverable       Boolean   @default(false)
  avatarPath         String?   @map("avatar_path")
  bio                String?   @db.VarChar(1000)
  skills             String[]  @default([])
  githubUrl          String?   @map("github_url") @db.VarChar(255)
  behanceUrl         String?   @map("behance_url") @db.VarChar(255)
  linkedinUrl        String?   @map("linkedin_url") @db.VarChar(255)
  profileCompletedAt DateTime? @map("profile_completed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user             User              @relation(fields: [userId], references: [id])
  enrollments      SectionStudent[]
  groupMembers     GroupMember[]
  individualWorks  IndividualWork[]
  topics           Topic[]
  submissions      Submission[]      @relation("PersonalSubmissions")
  lastSubmitted    Submission[]      @relation("LastSubmittedBy")
  uploadedFiles    SubmissionFile[]
  views            AssignmentView[]
  groupReports     GroupReport[]
  assignmentGrades AssignmentGrade[]
  sectionGrades    SectionGrade[]
  parents          ParentStudent[]

  gradeRequests GradeChangeRequest[]

  adminClassId String?     @map("admin_class_id") @db.Uuid
  adminClass   AdminClass? @relation(fields: [adminClassId], references: [id])

  @@map("students")
}

// ===================== Đào tạo =====================

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN

  @@map("parent_relation")
}

/// Tài khoản phụ huynh – tự sinh từ SĐT trong hồ sơ SV (UC03.3)
model Parent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  phone     String   @unique @db.VarChar(10)
  fullName  String?  @map("full_name") @db.VarChar(100)
  email     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User            @relation(fields: [userId], references: [id])
  students ParentStudent[]

  @@map("parents")
}

model ParentStudent {
  parentId  String         @map("parent_id") @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  relation  ParentRelation
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@id([parentId, studentId, relation])
  @@unique([studentId, relation])
  @@map("parent_students")
}

/// Ghi chú riêng của GV trên một bài nộp – chỉ GV viết mới thấy (SV không bao giờ thấy)
model LecturerNote {
  submissionId String   @map("submission_id") @db.Uuid
  lecturerId   String   @map("lecturer_id") @db.Uuid
  content      String   @default("") @db.VarChar(2000)
  /// Đánh dấu bài mẫu để tìm lại cho khóa sau
  isSample     Boolean  @default(false) @map("is_sample")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  lecturer   Lecturer   @relation(fields: [lecturerId], references: [id])

  @@id([submissionId, lecturerId])
  @@index([lecturerId, isSample])
  @@map("lecturer_notes")
}

/// Thư mục học kỳ trên Drive của GV: EduPortfolio_<GV>/<năm học>_<HK>/
model LecturerSemesterFolder {
  lecturerId   String   @map("lecturer_id") @db.Uuid
  semesterId   String   @map("semester_id") @db.Uuid
  /// thư mục gốc lúc tạo – đổi tài khoản Google thì tạo lại
  rootFolderId String   @map("root_folder_id") @db.VarChar(100)
  folderId     String   @map("folder_id") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  lecturer Lecturer @relation(fields: [lecturerId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  @@id([lecturerId, semesterId])
  @@map("lecturer_semester_folders")
}

/// Liên kết đặt lại mật khẩu (UC01.5) – lưu băm của token, hiệu lực 30 phút, dùng một lần
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum GradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("grade_request_status")
}

/// Yêu cầu sửa điểm học phần sau khi bảng điểm đã khóa (UC07.7 – GV gửi, UC07.8 – Admin duyệt)
model GradeChangeRequest {
  id           String             @id @default(uuid()) @db.Uuid
  sectionId    String             @map("section_id") @db.Uuid
  studentId    String             @map("student_id") @db.Uuid
  lecturerId   String             @map("lecturer_id") @db.Uuid
  /// { attendance?, assignment?, midterm?, final? } trước và sau
  oldValues    Json               @map("old_values")
  newValues    Json               @map("new_values")
  reason       String             @db.VarChar(1000)
  status       GradeRequestStatus @default(PENDING)
  adminNote    String?            @map("admin_note") @db.VarChar(500)
  resolvedById String?            @map("resolved_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt   DateTime?          @map("resolved_at") @db.Timestamptz

  section  CourseSection @relation(fields: [sectionId], references: [id])
  student  Student       @relation(fields: [studentId], references: [id])
  lecturer Lecturer      @relation(fields: [lecturerId], references: [id])

  @@index([sectionId, status])
  @@index([status, createdAt])
  @@map("grade_change_requests")
}

/// Danh mục dùng chung (UC02.6): khoa → ngành → lớp sinh hoạt (theo khóa)
model Faculty {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @unique @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  majors    Major[]
  lecturers Lecturer[]
  courses   Course[]

  @@map("faculties")
}

model Major {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(200)
  facultyId String   @map("faculty_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  faculty Faculty      @relation(fields: [facultyId], references: [id])
  classes AdminClass[]

  @@map("majors")
}

model Cohort {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(10)
  startYear Int      @map("start_year") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  classes AdminClass[]

  @@map("cohorts")
}

/// Lớp sinh hoạt (lớp hành chính) – ngành, khóa của SV lấy theo lớp
model AdminClass {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(30)
  majorId   String   @map("major_id") @db.Uuid
  cohortId  String   @map("cohort_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  major    Major     @relation(fields: [majorId], references: [id])
  cohort   Cohort    @relation(fields: [cohortId], references: [id])
  students Student[]

  @@map("admin_classes")
}

/// Tài khoản doanh nghiệp (UC01.8 đăng ký, UC02.7 Admin duyệt). Trạng thái theo users.status
model Enterprise {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  name         String    @db.VarChar(200)
  taxCode      String    @unique @map("tax_code") @db.VarChar(20)
  email        String    @unique @db.VarChar(255)
  contactName  String    @map("contact_name") @db.VarChar(100)
  phone        String    @db.VarChar(15)
  field        String    @db.VarChar(100)
  website      String?   @db.VarChar(255)
  rejectReason String?   @map("reject_reason") @db.VarChar(500)
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("enterprises")
}

/// Cấu hình hệ thống (UC02.13) – một dòng key = 'main'
model SystemConfig {
  key         String   @id @db.VarChar(40)
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_configs")
}

model Semester {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(20)
  academicYear String   @map("academic_year") @db.VarChar(9)
  term         TermType
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  isCurrent    Boolean  @default(false) @map("is_current")

  sections        CourseSection[]
  lecturerFolders LecturerSemesterFolder[]

  @@map("semesters")
}

model Course {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(20)
  name        String     @db.VarChar(200)
  credits     Int        @db.SmallInt
  courseType  CourseType @map("course_type")
  wAttendance Int        @default(10) @map("w_attendance") @db.SmallInt
  wAssignment Int        @default(30) @map("w_assignment") @db.SmallInt
  wMidterm    Int        @default(20) @map("w_midterm") @db.SmallInt
  wFinal      Int        @default(40) @map("w_final") @db.SmallInt
  isActive    Boolean    @default(true) @map("is_active")

  sections CourseSection[]

  facultyId String?  @map("faculty_id") @db.Uuid
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  @@map("courses")
}

model CourseSection {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique @db.VarChar(30)
  courseId          String    @map("course_id") @db.Uuid
  semesterId        String    @map("semester_id") @db.Uuid
  lecturerId        String    @map("lecturer_id") @db.Uuid
  maxStudents       Int       @map("max_students") @db.SmallInt
  schedule          String?   @db.VarChar(200)
  gradesPublishedAt DateTime? @map("grades_published_at") @db.Timestamptz
  /// Thư mục lớp trên Drive: <học kỳ>/<MaLHP>_<TenMon>/ (của GV phụ trách)
  driveFolderId     String?   @map("drive_folder_id") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  course      Course           @relation(fields: [courseId], references: [id])
  semester    Semester         @relation(fields: [semesterId], references: [id])
  lecturer    Lecturer         @relation(fields: [lecturerId], references: [id])
  students    SectionStudent[]
  assignments Assignment[]
  grades      SectionGrade[]

  gradeRequests GradeChangeRequest[]

  /// Tuần học (UC02.9)
  weekStart Int  @default(1) @map("week_start") @db.SmallInt
  weekEnd   Int  @default(15) @map("week_end") @db.SmallInt
  /// Lịch học hằng tuần: [{ day: 2..8, from: 1..12, to: 1..12, room }]
  sessions  Json @default("[]")

  @@index([lecturerId])
  @@map("course_sections")
}

model SectionStudent {
  sectionId  String   @map("section_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id])

  @@id([sectionId, studentId])
  @@index([studentId])
  @@map("section_students")
}

// ===================== Drive =====================

model LecturerDriveLink {
  id              String          @id @default(uuid()) @db.Uuid
  lecturerId      String          @unique @map("lecturer_id") @db.Uuid
  authMode        DriveAuthMode   @default(OAUTH) @map("auth_mode")
  rootFolderId    String          @map("root_folder_id") @db.VarChar(100)
  rootFolderUrl   String          @map("root_folder_url")
  rootFolderName  String?         @map("root_folder_name") @db.VarChar(255)
  sharedDriveId   String?         @map("shared_drive_id") @db.VarChar(100)
  status          DriveLinkStatus @default(OK)
  checkedAt       DateTime        @default(now()) @map("checked_at") @db.Timestamptz
  /// OAuth: tài khoản Google của GV + refresh token đã mã hóa (AES-256-GCM)
  googleEmail     String?         @map("google_email") @db.VarChar(255)
  refreshTokenEnc String?         @map("refresh_token_enc")
  linkedAt        DateTime?       @map("linked_at") @db.Timestamptz

  lecturer Lecturer @relation(fields: [lecturerId], references: [id])

  @@map("lecturer_drive_links")
}

// ===================== Bài tập, nhóm, đề tài =====================

model Assignment {
  id                  String           @id @default(uuid()) @db.Uuid
  sectionId           String           @map("section_id") @db.Uuid
  batchId             String?          @map("batch_id") @db.Uuid
  title               String           @db.VarChar(200)
  description         String?
  workMode            WorkMode         @map("work_mode")
  hasIndividualPart   Boolean          @default(false) @map("has_individual_part")
  productTypes        ProductType[]    @map("product_types")
  openAt              DateTime         @map("open_at") @db.Timestamptz
  dueAt               DateTime         @map("due_at") @db.Timestamptz
  allowLate           Boolean          @default(false) @map("allow_late")
  lateDueAt           DateTime?        @map("late_due_at") @db.Timestamptz
  /// Trọng số (%) khi tính cột "Bài tập" của điểm học phần
  weight              Int              @default(10) @db.SmallInt
  suggestedTopics     String[]         @default([]) @map("suggested_topics")
  /// false = bản nháp, chỉ mở khi GV bấm "Giao bài"
  autoOpen            Boolean          @default(true) @map("auto_open")
  briefFileName       String?          @map("brief_file_name") @db.VarChar(255)
  briefFilePath       String?          @map("brief_file_path")
  briefFileSize       BigInt?          @map("brief_file_size")
  briefMimeType       String?          @map("brief_mime_type") @db.VarChar(100)
  briefDriveFileId    String?          @map("brief_drive_file_id") @db.VarChar(100)
  status              AssignmentStatus
  driveParentFolderId String           @map("drive_parent_folder_id") @db.VarChar(100)
  driveFolderId       String           @map("drive_folder_id") @db.VarChar(100)
  groupsImportedAt    DateTime?        @map("groups_imported_at") @db.Timestamptz
  gradesPublishedAt   DateTime?        @map("grades_published_at") @db.Timestamptz
  deadlineProcessedAt DateTime?        @map("deadline_processed_at") @db.Timestamptz
  createdById         String           @map("created_by") @db.Uuid
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  section         CourseSection     @relation(fields: [sectionId], references: [id])
  createdBy       Lecturer          @relation(fields: [createdById], references: [id])
  groups          Group[]
  groupMembers    GroupMember[]
  individualWorks IndividualWork[]
  topics          Topic[]
  submissions     Submission[]
  views           AssignmentView[]
  groupReports    GroupReport[]
  grades          AssignmentGrade[]
  importJobs      ImportJob[]

  @@index([sectionId, status])
  @@index([status, dueAt])
  @@index([batchId])
  @@map("assignments")
}

/// Nhóm do GV tạo từ file Excel (cột Mã nhóm, Tên nhóm, Trưởng nhóm)
model Group {
  id                  String   @id @default(uuid()) @db.Uuid
  assignmentId        String   @map("assignment_id") @db.Uuid
  seq                 Int      @db.SmallInt
  code                String   @db.VarChar(20)
  name                String   @db.VarChar(100)
  leaderId            String?  @map("leader_id") @db.Uuid
  importJobId         String?  @map("import_job_id") @db.Uuid
  driveFolderId       String?  @map("drive_folder_id") @db.VarChar(100)
  driveSharedFolderId String?  @map("drive_shared_folder_id") @db.VarChar(100)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assignment  Assignment    @relation(fields: [assignmentId], references: [id])
  members     GroupMember[]
  topic       Topic?
  submissions Submission[]

  @@unique([assignmentId, seq])
  @@unique([assignmentId, code])
  @@map("groups")
}

model GroupMember {
  groupId               String     @map("group_id") @db.Uuid
  studentId             String     @map("student_id") @db.Uuid
  assignmentId          String     @map("assignment_id") @db.Uuid
  role                  MemberRole @default(MEMBER)
  joinedAt              DateTime   @default(now()) @map("joined_at") @db.Timestamptz
  drivePersonalFolderId String?    @map("drive_personal_folder_id") @db.VarChar(100)

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@id([groupId, studentId])
  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("group_members")
}

model IndividualWork {
  assignmentId  String   @map("assignment_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  driveFolderId String?  @map("drive_folder_id") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@id([assignmentId, studentId])
  @@map("individual_works")
}

/// Đề tài: chỉ gồm tên + từ khóa (không duyệt)
model Topic {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  groupId      String?  @unique @map("group_id") @db.Uuid
  studentId    String?  @map("student_id") @db.Uuid
  title        String   @db.VarChar(200)
  keywords     String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assignment  Assignment     @relation(fields: [assignmentId], references: [id])
  group       Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student     Student?       @relation(fields: [studentId], references: [id])
  submissions Submission[]
  histories   TopicHistory[]

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@map("topics")
}

/// Lịch sử đề tài: tạo, sửa
model TopicHistory {
  id        String      @id @default(uuid()) @db.Uuid
  topicId   String      @map("topic_id") @db.Uuid
  actorId   String      @map("actor_id") @db.Uuid
  action    TopicAction
  title     String      @db.VarChar(200)
  note      String?     @db.VarChar(1000)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([topicId, createdAt])
  @@map("topic_histories")
}

/// SV đã mở trang bài tập (thẻ "Đã xem đề bài")
model AssignmentView {
  assignmentId  String   @map("assignment_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  firstViewedAt DateTime @default(now()) @map("first_viewed_at") @db.Timestamptz

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@id([assignmentId, studentId])
  @@map("assignment_views")
}

/// SV báo nhóm chưa đúng (UC05.6)
model GroupReport {
  id             String       @id @default(uuid()) @db.Uuid
  assignmentId   String       @map("assignment_id") @db.Uuid
  studentId      String       @map("student_id") @db.Uuid
  groupId        String?      @map("group_id") @db.Uuid
  content        String       @db.VarChar(500)
  status         ReportStatus @default(OPEN)
  resolutionNote String?      @map("resolution_note") @db.VarChar(500)
  resolvedById   String?      @map("resolved_by") @db.Uuid
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@index([assignmentId, status])
  @@map("group_reports")
}

// ===================== Nộp bài =====================

model Submission {
  id                  String           @id @default(uuid()) @db.Uuid
  assignmentId        String           @map("assignment_id") @db.Uuid
  kind                SubmissionKind
  groupId             String?          @map("group_id") @db.Uuid
  studentId           String?          @map("student_id") @db.Uuid
  topicId             String?          @map("topic_id") @db.Uuid
  lastSubmittedById   String           @map("last_submitted_by") @db.Uuid
  figmaUrl            String?          @map("figma_url") @db.VarChar(500)
  gitUrl              String?          @map("git_url") @db.VarChar(500)
  note                String?          @db.VarChar(2000)
  /// Phần cá nhân: mức đóng góp tự đánh giá (%)
  contributionPercent Int?             @map("contribution_percent") @db.SmallInt
  version             Int              @default(1)
  submittedAt         DateTime         @map("submitted_at") @db.Timestamptz
  isLate              Boolean          @default(false) @map("is_late")
  status              SubmissionStatus
  syncStatus          SyncSummary      @default(PENDING) @map("sync_status")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  assignment      Assignment        @relation(fields: [assignmentId], references: [id])
  group           Group?            @relation(fields: [groupId], references: [id])
  student         Student?          @relation("PersonalSubmissions", fields: [studentId], references: [id])
  topic           Topic?            @relation(fields: [topicId], references: [id])
  lastSubmittedBy Student           @relation("LastSubmittedBy", fields: [lastSubmittedById], references: [id])
  files           SubmissionFile[]
  events          SubmissionEvent[]
  lecturerNotes   LecturerNote[]

  @@index([assignmentId, status])
  @@index([groupId])
  @@index([studentId])
  @@map("submissions")
}

model SubmissionFile {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  fileType     FileType       @map("file_type")
  originalName String         @map("original_name") @db.VarChar(255)
  mimeType     String         @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt         @map("size_bytes")
  sha256       String         @db.Char(64)
  sortOrder    Int            @map("sort_order") @db.SmallInt
  driveFileId  String?        @map("drive_file_id") @db.VarChar(100)
  localPath    String?        @map("local_path")
  syncStatus   FileSyncStatus @default(PENDING) @map("sync_status")
  retryCount   Int            @default(0) @map("retry_count") @db.SmallInt
  nextRetryAt  DateTime?      @map("next_retry_at") @db.Timestamptz
  lastError    String?        @map("last_error")
  uploadedById String         @map("uploaded_by") @db.Uuid
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy Student    @relation(fields: [uploadedById], references: [id])

  @@index([submissionId, sortOrder])
  @@index([syncStatus, nextRetryAt])
  @@map("submission_files")
}

model SubmissionEvent {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  submissionId String?          @map("submission_id") @db.Uuid
  kind         SubmissionKind
  groupId      String?          @map("group_id") @db.Uuid
  studentId    String?          @map("student_id") @db.Uuid
  actorId      String           @map("actor_id") @db.Uuid
  action       SubmissionAction
  version      Int
  detail       Json?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([assignmentId, groupId])
  @@index([assignmentId, studentId])
  @@map("submission_events")
}

// ===================== Điểm (tải lên từ Excel) =====================

model AssignmentGrade {
  assignmentId String   @map("assignment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  score        Decimal? @db.Decimal(3, 1)
  note         String?  @db.VarChar(1000)
  importJobId  String?  @map("import_job_id") @db.Uuid
  updatedById  String   @map("updated_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@id([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_grades")
}

model SectionGrade {
  id          String      @id @default(uuid()) @db.Uuid
  sectionId   String      @map("section_id") @db.Uuid
  studentId   String      @map("student_id") @db.Uuid
  attendance  Decimal?    @db.Decimal(3, 1)
  assignment  Decimal?    @db.Decimal(3, 1)
  midterm     Decimal?    @db.Decimal(3, 1)
  final       Decimal?    @db.Decimal(3, 1)
  total       Decimal?    @db.Decimal(3, 1)
  letter      String?     @db.VarChar(2)
  gpa4        Decimal?    @db.Decimal(2, 1)
  status      GradeStatus @default(DRAFT)
  importJobId String?     @map("import_job_id") @db.Uuid
  updatedById String      @map("updated_by") @db.Uuid
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  section CourseSection @relation(fields: [sectionId], references: [id])
  student Student       @relation(fields: [studentId], references: [id])

  @@unique([sectionId, studentId])
  @@map("section_grades")
}

/// Mỗi lần GV tải file Excel (nhóm / điểm): bản xem trước rồi áp dụng
model ImportJob {
  id           String       @id @default(uuid()) @db.Uuid
  type         ImportType
  assignmentId String?      @map("assignment_id") @db.Uuid
  sectionId    String?      @map("section_id") @db.Uuid
  fileName     String       @map("file_name") @db.VarChar(255)
  status       ImportStatus @default(PREVIEW)
  totalRows    Int          @map("total_rows")
  errorRows    Int          @map("error_rows")
  preview      Json
  errors       Json
  createdById  String       @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  completedAt  DateTime?    @map("completed_at") @db.Timestamptz

  assignment Assignment? @relation(fields: [assignmentId], references: [id])
  createdBy  User        @relation(fields: [createdById], references: [id])

  @@index([assignmentId, type, createdAt(sort: Desc)])
  @@index([sectionId, type, createdAt(sort: Desc)])
  @@map("import_jobs")
}

// ===================== Thông báo =====================

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(1000)
  link      String?   @db.VarChar(300)
  dedupeKey String?   @map("dedupe_key") @db.VarChar(150)
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ===================== Hệ thống =====================

/// Nhật ký hệ thống – dùng cho "Lịch sử thay đổi" của bài tập, nhắc SV…
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  summary    String?  @db.VarChar(500)
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
