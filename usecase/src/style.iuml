' Style dùng chung cho các sơ đồ use case EduPortfolio
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam dpi 150
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor #DDF2FC
  BorderColor #2B6A8F
  FontSize 15
  FontStyle bold
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2B2B2B
  FontSize 13
}
skinparam actor {
  BackgroundColor #6CC4EE
  BorderColor #2B2B2B
  FontSize 13
}
skinparam ArrowColor #333333
skinparam ArrowFontSize 11
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #B8A35A
  FontSize 11
}
skinparam legend {
  BackgroundColor #FFFBEA
  BorderColor #B8A35A
  FontSize 12
}
